# Telegram MTProto (GramJS) — приватный канал-БД
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
DB_CHANNEL_ID=

# Telegram Bot API — только шлёт напоминания
NOTIFY_BOT_TOKEN=
# chat_id, куда бот шлёт напоминания (id Марты в Telegram).
# Не входил в исходный список env в CLAUDE.md, но без него Bot API sendMessage
# не знает, кому слать — см. BL-11 в MAR.Plan.md.
NOTIFY_CHAT_ID=

# Гейт приложения
APP_PASSWORD=

# Защита /api/cron/*
CRON_SECRET=

# Соль для PBKDF2 (сейф, v3)
VAULT_SALT=

# Токен для MCP-сервера noname (доступ агента к API).
# Сгенерировать: openssl rand -hex 32
# Отдельный от APP_PASSWORD — чтобы отозвать доступ агента, не меняя вход.
MCP_TOKEN=
